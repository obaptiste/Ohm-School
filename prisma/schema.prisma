generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Fault {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  summary            String
  description        String
  severity           String
  dangerNotes        String
  commonSymptoms     Json
  likelyCauses       Json
  safeChecks         Json
  escalationRules    Json
  escalationGuidance String
  educationalExplanation String
  electricianTestsNext Json
  relatedFaultSlugs  String[]
  tags               String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Symptom {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
}

model DecisionTree {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  symptomSlug String
  startNodeId String
  nodes       DecisionNode[]
}

model DecisionNode {
  id                String          @id @default(cuid())
  treeId            String
  key               String
  question          String
  explanation       String
  questionType      String
  severity          String?
  safetyGate        Boolean         @default(false)
  stopReason        String?
  educationalNote   String?
  recommendedAction String?
  tree              DecisionTree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  options           DecisionOption[]
}

model DecisionOption {
  id                     String   @id @default(cuid())
  nodeId                 String
  label                  String
  value                  String
  nextNodeKey            String?
  scoreModifier          Int      @default(0)
  riskBoost              Int      @default(0)
  urgentTrigger          Boolean  @default(false)
  faultWeightAdjustments Json
  node                   DecisionNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model DiagnosisSession {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  symptomSlug    String
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  resultFaultSlug String?
  riskLevel      String?
  answers        DiagnosisAnswer[]
}

model DiagnosisAnswer {
  id                 String   @id @default(cuid())
  diagnosisSessionId String
  nodeKey            String
  answerValue        String
  diagnosisSession   DiagnosisSession @relation(fields: [diagnosisSessionId], references: [id], onDelete: Cascade)
}

model LearningArticle {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  body              String
  relatedFaultSlugs String[]
}
